{
  "name": "busca-licitacoes-backend-dev",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "postCreateCommand": "npm ci",
  "postStartCommand": "docker compose up -d mysql && [ -f .env.local ] || cp .env.example .env.local",
  "forwardPorts": [3000, 3306],
  "portsAttributes": {
    "3000": {
      "label": "Next.js (dev)"
    },
    "3306": {
      "label": "MySQL"
    }
  },
  "remoteEnv": {
    "NODE_ENV": "development",
    "DATABASE_URL": "SET_IN_DOTENV_LOCAL",
    "NEXTAUTH_SECRET": "dev-only-change-me",
    "APP_URL": "http://localhost:3000"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "prisma.prisma",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
